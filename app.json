{
  "expo": {
    "name": "terminalDeck",
    "slug": "terminalDeck",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "terminaldeck",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090A0F",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aceakki.terminaldeck",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": {
      "package": "com.aceakki.terminaldeck",
      "permissions": ["SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#04080B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TasksList",
              "label": "Tasks",
              "description": "Recent tasks with current / priority tabs",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "TaskCountActive",
              "label": "Active tasks",
              "description": "Number of active tasks",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TaskCountP0",
              "label": "P0 tasks",
              "description": "Number of P0 tasks",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "AddTask",
              "label": "Add task",
              "description": "Tap to add a task",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 0
            },
            {
              "name": "PomodoroBar",
              "label": "Pomodoro bar",
              "description": "Compact Pomodoro timer",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroCard",
              "label": "Pomodoro card",
              "description": "Pomodoro timer with controls",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PomodoroTile",
              "label": "Pomodoro tile",
              "description": "Square Pomodoro timer",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/JetBrainsMono-Regular.ttf",
            "./assets/fonts/JetBrainsMono-Medium.ttf",
            "./assets/fonts/JetBrainsMono-Bold.ttf",
            "./assets/fonts/JetBrainsMono-Italic.ttf",
            "./assets/fonts/FiraCode-Light.ttf",
            "./assets/fonts/Inter18pt-Regular.ttf",
            "./assets/fonts/Inter18pt-Medium.ttf",
            "./assets/fonts/Inter18pt-SemiBold.ttf",
            "./assets/fonts/Inter18pt-Bold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "terminalDeck uses your location to show the weather where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00E5FF",
          "sounds": [
            "./assets/sounds/ctos_alert.wav",
            "./assets/sounds/ctos_chime.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "useLegacyPackaging": true
          }
        }
      ],
      ["./plugins/withPackageQueries"],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
